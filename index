<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<title>Age of the Conquistadors</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&display=swap">
<style>
:root{--gold:#e7b85a;--gold2:#b9863a;--ink:#f3e6c8;--mut:#a8977a;--pn:linear-gradient(180deg,#261b12,#16100b);--bd:#4d3a24;--t:'Cinzel',Georgia,'Times New Roman',serif;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark}
*{box-sizing:border-box}
html,body{margin:0;background:radial-gradient(ellipse at 50% 0,#2a1d12,#0c0907 70%) #0c0907;color:var(--ink);font-family:Georgia,'Times New Roman',serif}
#app{max-width:1200px;margin:0 auto;padding:10px;display:flex;flex-direction:column;gap:10px}
#top,#hud,#bar,#ctl{background:var(--pn);border:1px solid var(--bd);border-radius:12px;box-shadow:0 4px 14px #0008,inset 0 1px 0 #ffffff12}
#top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:8px 14px}
.brand{display:flex;align-items:center;gap:10px}.brand svg{width:36px;height:36px}.brand h2{margin:0;font:700 19px var(--t);letter-spacing:.06em;color:var(--gold)}.brand span{font-size:11px;color:var(--mut);letter-spacing:.18em;text-transform:uppercase}
#steps{display:flex;gap:6px;list-style:none;margin:0;padding:0}
#steps li{display:flex;align-items:center;gap:7px;font:600 12px var(--t);letter-spacing:.08em;text-transform:uppercase;color:var(--mut);padding:5px 12px 5px 6px;border-radius:99px}
#steps li b{display:grid;place-items:center;width:20px;height:20px;border-radius:50%;background:#2c2218;font-size:11px}
#steps li.on{color:#1a1006;background:linear-gradient(#f0c56c,#c58f3c)}#steps li.on b{background:#1a1006;color:var(--gold)}
.lvl{font:600 13px var(--t);letter-spacing:.1em;text-transform:uppercase;color:var(--mut)}.lvl b{font-size:22px;color:var(--gold);margin-left:4px}
#hud{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:14px;padding:10px 14px}
.hl{display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px;color:var(--mut)}.hl b{color:var(--ink);font-family:var(--t)}
.meter{height:12px;border-radius:99px;background:#0c0806;border:1px solid #3a2b1a;overflow:hidden;box-shadow:inset 0 2px 4px #000a}
.meter i{display:block;height:100%;width:100%;border-radius:99px;transition:width .25s}
.me .meter i{background:linear-gradient(#6aa8ff,#2c5fc8)}.foe .meter i{background:linear-gradient(#ff7a7e,#b52a30)}.foe .hl{flex-direction:row-reverse}.foe .meter{direction:rtl}
.vs{font:800 15px var(--t);color:var(--gold);width:42px;height:42px;display:grid;place-items:center;border:2px solid var(--gold2);border-radius:50%;background:#1a120b}
#wrap{position:relative;border-radius:12px;padding:6px;background:linear-gradient(#6b4d2a,#2c1e10);box-shadow:0 10px 30px #000a}
canvas{width:100%;height:auto;display:block;border-radius:8px;touch-action:none;cursor:crosshair}
#ov{position:absolute;inset:6px;display:flex;align-items:center;justify-content:center;background:rgba(8,5,3,.72);backdrop-filter:blur(3px);border-radius:8px;padding:12px}
.card{max-width:540px;width:100%;text-align:center;background:var(--pn);border:1px solid var(--gold2);border-radius:14px;padding:22px 24px;box-shadow:0 12px 40px #000c,inset 0 0 0 4px #00000040}
.card svg{width:64px;height:64px}.card h1{font:800 clamp(26px,5vw,40px) var(--t);margin:6px 0 8px;color:var(--gold);letter-spacing:.05em;text-shadow:0 2px 12px #e8803a66}
.card p{margin:6px 0;color:#d8c9aa;line-height:1.45;font-size:15px}.card .a{margin-top:16px;font-size:16px;padding:12px 30px}
.how{list-style:none;margin:12px 0 0;padding:0;display:grid;gap:6px;text-align:left}.how li{background:#00000040;border:1px solid #3d2e1c;border-radius:8px;padding:8px 10px;font-size:14px;color:#d8c9aa}.how b{color:var(--gold);font-family:var(--t)}
#dock{display:grid;grid-template-columns:1fr auto;gap:10px}
#bar{display:grid;grid-template-columns:repeat(auto-fit,minmax(112px,1fr));gap:8px;padding:10px}
.b{position:relative;display:flex;flex-direction:column;align-items:center;gap:3px;background:linear-gradient(#2e2216,#1b130c);color:var(--ink);border:1px solid #4d3a24;border-radius:10px;padding:6px 6px 8px;font:inherit;cursor:pointer;transition:.15s}
.b:hover:not(:disabled){transform:translateY(-2px);border-color:var(--gold2)}.b.on{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold),0 0 16px #e7b85a55;background:linear-gradient(#4a3418,#241810)}
.b.no{opacity:.5}.b:disabled{opacity:.4;cursor:not-allowed}
.ic{width:72px;height:72px;border-radius:8px;background:radial-gradient(circle at 50% 85%,#4a6b30,#1c2b14);overflow:hidden;display:block}.ic canvas{width:100%;height:100%;display:block}
.nm{font:700 12px var(--t);letter-spacing:.04em}.st{font-size:11px;color:var(--mut)}
.hk{position:absolute;top:4px;left:5px;font:700 10px var(--t);background:#000a;border-radius:4px;padding:1px 5px;color:var(--gold)}
.cs{position:absolute;top:4px;right:5px;font:700 11px var(--t);background:linear-gradient(#f0c56c,#c58f3c);color:#1a1006;border-radius:99px;padding:1px 7px}
.fp{display:grid;gap:2px;margin:1px 0}.fp i{width:9px;height:9px;background:var(--gold);border-radius:2px;display:block}
#ctl{display:flex;flex-direction:column;gap:8px;justify-content:center;min-width:210px;padding:10px}
.row{display:flex;gap:8px}.row .a{flex:1}
.a{font:700 14px var(--t);letter-spacing:.05em;padding:11px 16px;background:linear-gradient(#f0c56c,#c58f3c);color:#1a1006;border:1px solid #ffe3a0;border-radius:10px;cursor:pointer;box-shadow:0 3px 0 #7a5420,0 6px 14px #0008;transition:.12s}
.a:hover:not(:disabled){filter:brightness(1.1)}.a:active:not(:disabled){transform:translateY(2px);box-shadow:0 1px 0 #7a5420}
.a.s{background:linear-gradient(#3a2d1f,#241a11);color:var(--ink);border-color:#5a4429;box-shadow:0 3px 0 #120c07,0 6px 14px #0008;font-size:12px;padding:9px 8px}.a:disabled{opacity:.4;cursor:not-allowed}
#play{font-size:16px;padding:14px 16px}
.b.cm{border-color:#b9863a;background:linear-gradient(#3b2b14,#201509)}.b.cm .nm{color:var(--gold)}
.a.s.rdy:disabled{opacity:1}.a.s:disabled#abil{cursor:default}.a.s.rdy{background:linear-gradient(#f0c56c,#c58f3c);color:#1a1006;border-color:#ffe3a0;animation:pl .9s infinite alternate}@keyframes pl{to{filter:brightness(1.3)}}
.card .a+.a{margin-left:8px}.card .a.s{font-size:14px;padding:12px 22px}
#mapov{position:absolute;inset:6px;border-radius:8px;overflow:hidden;background:#cfae6e}
#mapov svg{width:100%;height:100%;display:block}
.mhd{position:absolute;top:8px;left:12px;right:12px;display:flex;justify-content:space-between;align-items:center;gap:8px;pointer-events:none;flex-wrap:wrap}.mhd>*{pointer-events:auto}
.mt{font:800 clamp(16px,2.6vw,24px) var(--t);color:#3a2410;text-shadow:0 1px 0 #fff7}.mt small{font-size:.62em;margin-left:10px;color:#7a4a10}
.mhd .row{gap:6px}.mhd .a.s{padding:7px 12px}
#brief{position:absolute;left:12px;bottom:12px;width:min(430px,calc(100% - 24px));background:linear-gradient(#261b12f2,#16100bf2);border:1px solid var(--gold2);border-radius:12px;padding:12px 16px;box-shadow:0 8px 28px #000a;font-size:13.5px;color:#e6d8b8;line-height:1.4}
#brief:empty{display:none}#brief p{margin:4px 0}#brief b{color:var(--gold)}.bt{font:800 18px var(--t);color:var(--gold)}.bk{font:600 11px var(--t);letter-spacing:.12em;text-transform:uppercase;color:var(--mut)}
#brief .row{margin-top:8px}#brief .a{font-size:14px;padding:9px 14px}
.pulse{transform-box:fill-box;transform-origin:center;animation:pu 1.4s ease-out infinite}@keyframes pu{from{transform:scale(1);opacity:.85}to{transform:scale(1.9);opacity:0}}
.nd{cursor:pointer}.nd.lk{cursor:not-allowed}
@media(max-width:760px){#brief{font-size:12px;padding:8px 10px}#brief p{margin:2px 0}.bt{font-size:15px}}
footer{text-align:center;font-size:12px;color:var(--mut);padding:0 8px 8px}
@media(max-width:760px){#dock{grid-template-columns:1fr}#ctl{min-width:0}#hud{grid-template-columns:1fr}.vs,#steps{display:none}.ic{width:60px;height:60px}}
.ct{font:700 11px var(--t);color:var(--gold);min-height:14px}
#syn{display:flex;flex-direction:column;gap:6px;background:var(--pn);border:1px solid var(--bd);border-radius:12px;padding:8px 12px;font-size:12px}
.sr{display:flex;flex-wrap:wrap;gap:6px;align-items:center}.sr>b{font:700 11px var(--t);letter-spacing:.08em;text-transform:uppercase;color:var(--mut);min-width:80px}
.ch{padding:3px 9px;border-radius:99px;border:1px solid #5a4429;background:#00000050;color:#d8c9aa}.ch.n{opacity:.6}
.t1{border-color:#7fbf6a;color:#b9f0a6}.t2{border-color:#6aa8ff;color:#b6d6ff}.t3{border-color:#ffd470;color:#ffe9a8}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px}

/* ===== v7: tudo cabe na tela ===== */
html,body{height:100%;overflow:hidden}
#app{height:100dvh;padding:6px;gap:6px;overflow:hidden}
#top{padding:4px 12px}.brand svg{width:28px;height:28px}.brand h2{font-size:16px}
#hud{padding:5px 12px;gap:10px}.hl{margin-bottom:2px}.vs{width:32px;height:32px;font-size:12px}
#wrap{margin:0 auto;flex:none}
#ov{overflow:auto}
.card{padding:14px 18px;max-height:100%;overflow:auto}
#dock{gap:6px}#bar{padding:6px;gap:6px;grid-template-columns:repeat(auto-fit,minmax(92px,1fr))}
.b{padding:4px 4px 5px;gap:2px}.ic{width:52px;height:52px}.nm{font-size:11px}.st{font-size:10px}.fp{display:none}
#ctl{padding:6px;gap:5px;min-width:190px}.a{padding:8px 12px}#play{padding:10px 12px;font-size:14px}.a.s{padding:6px 8px}
#syn{padding:4px 10px}
footer{display:none}
@media(max-width:760px){#app{overflow:auto;height:auto;min-height:100dvh}html,body{overflow:auto}}

/* ===== v7.1: tabuleiro é o foco; painéis compactos ===== */
#app{max-width:1800px}
#top{padding:2px 12px;min-height:0}.brand span{display:none}.brand svg{width:24px;height:24px}.brand h2{font-size:15px}
#steps li{padding:3px 10px 3px 4px;font-size:11px}#steps li b{width:16px;height:16px;font-size:10px}
.lvl{font-size:12px}.lvl b{font-size:18px}
#hud{padding:3px 12px}.hl{font-size:12px;margin-bottom:1px}.meter{height:8px}.vs{width:28px;height:28px;font-size:11px}
#wrap{padding:4px}#ov,#mapov{inset:4px}
#dock{grid-template-columns:1fr auto;gap:6px;align-items:stretch}
#bar{padding:4px;gap:4px;grid-template-columns:repeat(auto-fill,minmax(78px,1fr))}
.b{padding:3px 3px 4px;gap:1px;border-radius:8px}
.ic{width:38px;height:38px}.nm{font-size:10px;letter-spacing:0;text-align:center;line-height:1.05}
.st{font-size:9px;line-height:1.05;text-align:center}.b .st+.st{display:none}
.hk{top:2px;left:3px;font-size:9px;padding:0 4px}.cs{top:2px;right:3px;font-size:10px;padding:0 5px}
.ct{min-height:0;font-size:9px}
#ctl{display:grid;grid-template-columns:1fr 1fr 1.4fr;gap:4px;min-width:340px;padding:4px;align-content:center}
#ctl>#play,#ctl>#abil,#ctl>#mapb{grid-column:1/-1}
#ctl>.row{display:contents}
#play{padding:8px 10px;font-size:14px}.a.s{font-size:10px;padding:5px 4px}
#syn{display:none;position:fixed;left:50%;transform:translateX(-50%);bottom:12px;z-index:30;width:min(960px,96vw);max-height:60vh;overflow:auto;box-shadow:0 10px 40px #000d}
#syn.open{display:flex}
#bonus{font:600 12px var(--t);letter-spacing:.08em;text-transform:uppercase;padding:4px 12px;background:linear-gradient(#3a2d1f,#241a11);color:var(--ink);border:1px solid #5a4429;border-radius:99px;cursor:pointer}

/* ===== v8 ===== */
#ctl>#fmt{grid-column:1/-1}
#shopb{font:600 12px var(--t);letter-spacing:.06em;padding:4px 12px;background:linear-gradient(#4a3418,#241810);color:#ffe9a8;border:1px solid var(--gold2);border-radius:99px;cursor:pointer}
#shop{display:none;position:fixed;inset:0;z-index:50;background:rgba(8,5,3,.8);backdrop-filter:blur(3px);align-items:center;justify-content:center;padding:10px}
.sh{width:min(980px,100%);max-height:94vh;display:flex;flex-direction:column;background:var(--pn);border:1px solid var(--gold2);border-radius:14px;box-shadow:0 12px 40px #000c;animation:pop .25s}
@keyframes pop{from{transform:scale(.94);opacity:0}}
.shh{display:flex;gap:14px;align-items:center;padding:10px 16px;border-bottom:1px solid var(--bd);font:700 18px var(--t);color:var(--gold)}.shh span{margin-left:auto;color:#ffe9a8}
.shb{overflow:auto;padding:4px 16px 16px}.shb h4{font:700 13px var(--t);letter-spacing:.12em;text-transform:uppercase;color:var(--mut);margin:14px 0 6px}
.sg{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:8px}
.sc{display:flex;flex-direction:column;gap:4px;background:#00000040;border:1px solid #3d2e1c;border-radius:10px;padding:8px 10px;font-size:13px;transition:.15s}.sc:hover{transform:translateY(-2px)}
.sc.on{border-color:var(--gold);box-shadow:0 0 12px #e7b85a44}.sc small{color:var(--mut);font-size:11px}.sc b{font-family:var(--t);color:var(--ink);font-size:13px}.sc .a{margin-top:auto}.sc em{color:var(--gold);font-size:12px}
#wp{position:absolute;left:14px;top:46px;width:200px;padding:8px 10px;background:rgba(12,8,5,.84);border:1px solid var(--gold2);border-radius:10px;pointer-events:none;transform-origin:0 0;display:none}
#wp .t{font:700 10px var(--t);letter-spacing:.12em;text-transform:uppercase;color:var(--mut)}
#wpv{font:800 34px var(--t);line-height:1.15;transition:color .3s}
#wpb{height:8px;border-radius:99px;background:#b52a30;overflow:hidden;margin:3px 0 6px}#wpb i{display:block;height:100%;width:0;background:linear-gradient(#6aa8ff,#2c5fc8);transition:width .4s}
#wc{border-radius:4px;background:#0006}#wp small{display:block;font-size:10px;color:var(--mut);margin-top:3px}#wp.busy #wpv{opacity:.6}
.b.lk{filter:grayscale(.85);opacity:.72}.b.lk .cs{background:linear-gradient(#666,#3a3a3a);color:#ffe9a8}
.sc .ic{width:56px;height:56px;align-self:center;flex:none}
#flt{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:4px;align-items:center}.fc{font:700 10px var(--t);letter-spacing:.04em;padding:3px 10px;border-radius:99px;border:1px solid #5a4429;background:#00000050;color:#d8c9aa;cursor:pointer}.fc:hover{border-color:var(--gold2)}.fc.on{background:linear-gradient(#f0c56c,#c58f3c);color:#1a1006;border-color:#ffe3a0}.fc.tg{margin-left:auto;border-color:#7fbf6a}
#bar{height:clamp(128px,22vh,210px);overflow-y:auto;align-content:start;scrollbar-width:thin}#flt{position:sticky;top:0;z-index:3;background:#1b130c;padding:2px 0 4px;margin-top:-2px;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none}.fc{padding:2px 9px;font-size:9.5px;white-space:nowrap;flex:none}.fc.tg{margin-left:6px}
#barw{display:flex;flex-direction:column;gap:4px;min-width:0;background:var(--pn);border:1px solid var(--bd);border-radius:12px;box-shadow:0 4px 14px #0008,inset 0 1px 0 #ffffff12;padding:4px}#barw #bar{background:none;border:0;box-shadow:none;padding:0 2px 0 0;height:clamp(112px,20vh,190px);flex:none}#barw #flt{position:static;overflow:visible;flex-wrap:wrap;margin:0;padding:0;background:none;flex:none;gap:4px}#barw .fc{font-size:10px;padding:3px 10px}
/* ===== v18: modo celular ===== */
#info{display:none;align-items:center;gap:6px;font-size:11px;line-height:1.25;color:#e6d8b8;background:var(--pn);border:1px solid var(--bd);border-radius:8px;padding:3px 8px}#info span{flex:1}#infx{background:none;border:0;color:var(--mut);font-size:18px;line-height:1;padding:0 4px;cursor:pointer}
.trb{display:none}
body.mob{overflow:hidden;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;touch-action:manipulation}
body.mob #app{display:flex;flex-direction:column;height:100dvh;min-height:0;overflow:hidden;padding:4px;gap:4px;max-width:none}
body.mob #top{padding:3px 8px;gap:6px;flex-wrap:nowrap;flex:none}body.mob .brand{gap:5px;min-width:0}body.mob .brand h2{font-size:12px;white-space:nowrap}body.mob .brand svg{width:20px;height:20px}
body.mob #steps{display:none}body.mob #shopb,body.mob #bonus{font-size:11px;padding:4px 9px;white-space:nowrap;margin-left:auto}body.mob #bonus{margin-left:0}body.mob .lvl{font-size:10px;white-space:nowrap}body.mob .lvl b{font-size:15px}
body.mob #hud{grid-template-columns:1fr auto 1fr;padding:3px 8px;gap:8px;flex:none}body.mob .hl{font-size:10px}body.mob .vs{display:grid;width:auto;min-width:36px;height:22px;border-radius:11px;font-size:10px;padding:0 6px}
body.mob #wp{display:none!important}body.mob #wrap{padding:2px;flex:none;margin:0 auto}
body.mob #ov{position:fixed;inset:0;z-index:60;border-radius:0;padding:8px;background:rgba(8,5,3,.92)}body.mob .card{padding:12px 14px;max-height:100%}body.mob .card p{font-size:13px}body.mob .how li{font-size:12px;padding:6px 8px}
body.mob #mapov{position:fixed;inset:0;z-index:60;border-radius:0;overflow:auto;padding-bottom:44vh}body.mob #msvg{width:max(100%,780px);height:auto;margin-top:44px}
body.mob .mhd{position:fixed;top:0;left:0;right:0;z-index:2;padding:6px 8px;background:#cfae6ef2;flex-wrap:nowrap}body.mob .mt{font-size:14px}body.mob .mt small{display:none}
body.mob #brief{position:fixed;left:0;right:0;bottom:0;width:auto;border-radius:12px 12px 0 0;max-height:42vh;overflow:auto;z-index:3;font-size:12px}
body.mob #syn{left:4px;right:4px;transform:none;width:auto;max-height:70vh;z-index:55}body.mob .sg{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}body.mob .shh{font-size:15px;padding:8px 12px}
body.mob #dock{display:flex;flex-direction:column;gap:4px;flex:1;min-height:0}
body.mob #barw{flex:1;min-height:100px;overflow:hidden}body.mob #barw #bar{height:auto;flex:1;min-height:0;grid-template-columns:repeat(auto-fill,minmax(74px,1fr))}
body.mob #ctl{min-width:0;display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:4px;flex:none}
body.mob #ctl>#play,body.mob #ctl>#abil,body.mob #ctl>#mapb,body.mob #ctl>#fmt{grid-column:1/-1}
body.mob #ctl .a{min-height:32px;padding:6px 4px;font-size:11px;white-space:normal}body.mob #play{font-size:14px;min-height:40px}
body.mob.land #app{padding-right:122px}
body.mob.land #dock{position:fixed;right:4px;top:4px;bottom:4px;width:112px;display:block;z-index:40}
body.mob.land #ctl{display:flex;flex-direction:column;height:100%;overflow-y:auto;gap:3px;padding:3px}body.mob.land #ctl .a{flex:none;min-height:30px;font-size:10px;padding:5px 3px}body.mob.land #ctl>.row{display:contents}
body.mob.land .trb{display:block}
body.mob.land #barw{display:none;position:fixed;left:4px;right:122px;bottom:4px;max-height:64vh;z-index:45;box-shadow:0 8px 30px #000d;min-height:0}body.mob.land #barw.open{display:flex}body.mob.land #barw #bar{max-height:calc(64vh - 44px)}
/* ===== v19: menu inicial ===== */
#mm{position:fixed;inset:0;z-index:70;display:none;overflow:hidden;background:#0c0907;color:var(--ink);font-family:var(--t);-webkit-user-select:none;user-select:none;touch-action:manipulation}
#mm.on{display:block}
#mmc{position:absolute;inset:0;width:100%;height:100%;display:block;border-radius:0;cursor:default;touch-action:manipulation}
#mm::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:radial-gradient(ellipse 30% 64% at 50% 40%,rgba(8,5,3,.66),rgba(8,5,3,0) 72%)}
