 function burst(x,y,col,n,sp,gv){for(let i=0;i<n;i++){const a=Math.random()*6.28,s=(sp||90)*Math.random();mparts.push({x,y,vx:Math.cos(a)*s*US,vy:(Math.sin(a)*s-40)*US,life:.4+Math.random()*.6,max:1,col,sz:(1.5+Math.random()*2.5)*US,g:(gv===undefined?300:gv)*US})}}
 function update(dt){
  const rm=RM.matches;tt+=dt;pmx+=(mx-pmx)*Math.min(1,dt*3);pmy+=(my-pmy)*Math.min(1,dt*3);
  for(const a of arm)for(const m of a){const u=m.u;if(!rm)u.t+=dt;if(u.atk>0)u.atk=Math.max(0,u.atk-dt*2.2);if(u.flash>0)u.flash=Math.max(0,u.flash-dt)}
  for(const l of later)l.t-=dt;for(const l of later)if(l.t<=0)l.fn();later=later.filter(l=>l.t>0);
  if(!rm){autoT-=dt;if(autoT<=0){autoT=4+Math.random()*4;volley(turn^=1)}}
  for(const p of mprojs){p.t+=dt;if(p.k==='fire'&&Math.random()<.8){const f=p.t/p.dur;mparts.push({x:p.sx+(p.tx-p.sx)*f,y:p.sy+(p.ty-p.sy)*f-p.arc*4*f*(1-f),vx:0,vy:-10*US,life:.35,max:.35,col:'#ff9a2a',sz:4*US,g:0})}
   if(p.t>=p.dur){p.done=1;p.tg.u.flash=.2;if(p.k==='rock'){burst(p.tx,p.ty,'#8a7a62',22,160);snd(70,.2,'sawtooth')}else if(p.k==='fire'){burst(p.tx,p.ty-10,'#ff8a1e',24,150,-40);burst(p.tx,p.ty-10,'#ffd23a',10,100,-40)}else burst(p.tx,p.ty,'#cdb88a',3,50,200)}}
  mprojs=mprojs.filter(p=>!p.done);
  for(const p of mparts){p.life-=dt;p.vy+=p.g*dt;p.x+=p.vx*dt;p.y+=p.vy*dt}mparts=mparts.filter(p=>p.life>0);
  if(!rm){const want=Math.round(vw*vh/16000);while(embers.length<want)embers.push({x:Math.random()*vw,y:vh*(.35+Math.random()*.7),vx:(8+Math.random()*16)*US,vy:-(14+Math.random()*30)*US,ph:Math.random()*6,sz:(1+Math.random()*2.2)*US,a:.3+Math.random()*.6});
   for(const e of embers){e.x+=(e.vx+Math.sin(tt*1.3+e.ph)*10*US)*dt;e.y+=e.vy*dt;if(e.y<-10||e.x>vw+10){e.x=Math.random()*vw*.9-vw*.1;e.y=vh+Math.random()*30}}
   for(const c of mclouds){c.x+=c.v*dt;if(c.x>W+150)c.x=-150}
   dragT-=dt;if(!drag&&dragT<=0){const u=mk(1,{t:'dragon',c:0,r:0},{});u.face=-1;u.moving=true;drag={u,x:vw+140*US,y:vh*(.14+Math.random()*.12),t:0}}
   if(drag){drag.t+=dt;drag.u.t+=dt;drag.x-=Math.max(70,vw/15)*dt;if(drag.x<-200*US){drag=null;dragT=30+Math.random()*25}}}}
 function unit(m,sh){const u=m.u,T=TY[u.type],fo=T.h*CH/2-6,k=m.k,o=ctx;u.x=0;u.y=0;ctx=g;
  g.save();g.translate(m.sx,m.sy-fo*k+Math.sin(tt*2.2+m.ph)*1.1*k);g.scale(k,k);try{drawU(u)}catch(e){}g.restore();ctx=o}
 function dragon(){const d=drag,o=ctx;ctx=g;
  g.ellipse=function(x,y,rx,ry,...r){if(x===0&&y===0&&ry===6)return;return CanvasRenderingContext2D.prototype.ellipse.call(g,x,y,rx,ry,...r)};
  g.save();g.translate(d.x,d.y+Math.sin(d.t*1.4)*12*US);g.scale(1.6*US,1.6*US);d.u.x=0;d.u.y=0;try{drawDragon(d.u,false,1,'#ff6a2a')}catch(e){}g.restore();delete g.ellipse;ctx=o}
 function banner(x,y,col,dir){const hh=200*US,w=62*US,h=116*US,top=y-hh,N=10,wv=i=>Math.sin(tt*2.6-i*.7+x)*(3+i*.9)*US*(i/N+.2);
  g.save();g.lineCap='round';g.strokeStyle='#3a2a18';g.lineWidth=5*US;g.beginPath();g.moveTo(x,y);g.lineTo(x,top);g.stroke();
  g.fillStyle='#e7b85a';g.beginPath();g.arc(x,top-2*US,5*US,0,7);g.fill();
  g.beginPath();for(let i=0;i<=N;i++)g.lineTo(x+dir*w*i/N,top+8*US+wv(i));for(let i=N;i>=0;i--)g.lineTo(x+dir*w*i/N,top+8*US+h*(1-.14*i/N)+wv(i));
  g.closePath();g.fillStyle=col;g.fill();g.strokeStyle='#e7b85a';g.lineWidth=2*US;g.stroke();
  const cx=x+dir*w*.45,cy=top+8*US+h*.46+wv(4),r=14*US;g.strokeStyle='#f3e6c8';g.lineWidth=3.5*US;g.beginPath();g.moveTo(cx-r,cy-r);g.lineTo(cx+r,cy+r);g.moveTo(cx+r,cy-r);g.lineTo(cx-r,cy+r);g.stroke();
  g.restore()}
 function draw(){
  g.setTransform(dpr,0,0,dpr,0,0);g.clearRect(0,0,vw,vh);const px=pmx-.5,py=pmy-.5;
  g.save();g.translate(OX-px*10,OY-py*4);g.scale(S,S);g.drawImage(sky,0,0);g.fillStyle='rgba(255,210,190,.35)';
  for(const c of mclouds)for(let i=0;i<5;i++){g.beginPath();g.ellipse(c.x+i*28*c.s-px*12,c.y+Math.sin(i*2)*8,46*c.s,16*c.s,0,0,7);g.fill()}
  g.restore();
  g.save();g.translate(OX-px*22,OY-py*8);g.scale(S,S);g.drawImage(land,0,0);g.restore();
  g.save();g.translate(-px*16,0);if(drag)dragon();g.restore();
  g.save();g.translate(-px*30,0);
  const band=vh-gy;banner(vw*.025,gy+band*.5,'#2c5fc8',1);banner(vw*.975,gy+band*.5,'#b52a30',-1);
  [...arm[0],...arm[1]].sort((a,b)=>a.sy-b.sy).forEach(unit);
  for(const p of mprojs){const f=p.t/p.dur,ar=q=>({x:p.sx+(p.tx-p.sx)*q,y:p.sy+(p.ty-p.sy)*q-p.arc*4*q*(1-q)}),a=ar(f),b=ar(Math.min(1,f+.03));
   g.save();g.translate(a.x,a.y);
   if(p.k==='arrow'){g.rotate(Math.atan2(b.y-a.y,b.x-a.x));g.lineWidth=1.8*US;g.strokeStyle='#cdb88a';g.beginPath();g.moveTo(-14*US,0);g.lineTo(0,0);g.stroke();g.fillStyle='#ddd';g.beginPath();g.moveTo(0,-2.5*US);g.lineTo(6*US,0);g.lineTo(0,2.5*US);g.fill()}
   else if(p.k==='rock'){g.fillStyle='#7d776a';g.beginPath();g.arc(0,0,7*US,0,7);g.fill();g.fillStyle='#5a554a';g.beginPath();g.arc(2*US,2*US,3*US,0,7);g.fill()}
   else{g.fillStyle='rgba(255,140,40,.35)';g.beginPath();g.arc(0,0,11*US,0,7);g.fill();g.fillStyle='#ffd34a';g.beginPath();g.arc(0,0,5*US,0,7);g.fill()}
   g.restore()}
  for(const p of mparts){g.globalAlpha=Math.max(0,Math.min(1,p.life/(p.max*.6)));g.fillStyle=p.col;g.fillRect(p.x,p.y,p.sz,p.sz)}g.globalAlpha=1;
  g.restore();
  g.globalCompositeOperation='lighter';for(const e of embers){g.fillStyle='rgba(255,150,60,'+(e.a*(.6+.4*Math.sin(tt*5+e.ph)))+')';g.beginPath();g.arc(e.x,e.y,e.sz,0,7);g.fill()}g.globalCompositeOperation='source-over';
  const vg=g.createRadialGradient(vw/2,vh/2,vh*.4,vw/2,vh/2,Math.max(vw,vh)*.68);vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(10,4,0,.55)');g.fillStyle=vg;g.fillRect(0,0,vw,vh)}
 function frame(ts){raf=requestAnimationFrame(frame);const dt=Math.min(.05,(ts-lt)/1000||0);lt=ts;layout();update(dt);draw()}
 M.addEventListener('pointermove',e=>{mx=e.clientX/(vw||1);my=e.clientY/(vh||1)});
 cvs.addEventListener('pointerdown',e=>{touched=true;volley(e.clientX<vw/2?0:1,true)});
 return{start(){if(!ready)build();size();if(!raf){lt=performance.now();raf=requestAnimationFrame(frame)}},stop(){cancelAnimationFrame(raf);raf=0},resize(){size()}}
})();
openMenu('main');
})();
</script>
